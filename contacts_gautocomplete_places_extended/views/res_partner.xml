<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_partner_form_inherit_gautocomplete_places_extended" model="ir.ui.view">
        <field name="name">view.res.partner.form.inherit.gautocomplete.places.extended</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">4000</field>
        <field name="arch" type="xml">
            <xpath expr="//h1/field[1]" position="attributes">
                <attribute name="widget">gplace_autocomplete_el</attribute>
                <attribute name="options">{'mapping_mode': 'places'}</attribute>
                <!-- <attribute name="options">{'mapping_code': 'VeJXBUBi'}</attribute> -->
            </xpath>
            <xpath expr="//h1/field[2]" position="attributes">
                <attribute name="widget">gplace_autocomplete_el</attribute>
                <attribute name="options">{'mapping_mode': 'places'}</attribute>
                <!-- <attribute name="options">{'mapping_code': 'VeJXBUBi'}</attribute> -->
            </xpath>
        </field>
    </record>
</odoo>