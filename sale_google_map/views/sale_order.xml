<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_sale_order_quotations_google_map" model="ir.ui.view">
        <field name="name">view.sale.order.quotations.google_map</field>
        <field name="model">sale.order</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <!-- Limit 1, as we grouped per partner_id, so only one record needed to show the marker on the map -->
            <google_map
                js_class="google_map_sale_order"
                limit="1"
                default_group_by="partner_id"
                string="Quotations"
                lat="partner_latitude"
                lng="partner_longitude"
                sidebar_title="name"
                sidebar_subtitle="partner_id"
            >
                <field name="partner_latitude" />
                <field name="partner_longitude" />
                <field name="name" />
                <field name="partner_id" />
                <field name="amount_total" />
            </google_map>
        </field>
    </record>
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field
            name="view_mode"
            model="ir.actions.act_window"
            eval="','.join(dict.fromkeys(obj(ref('sale.action_quotations_with_onboarding')).view_mode.split(',') + ['google_map']))"
        />
    </record>
    <record id="view_sale_order_orders_google_map" model="ir.ui.view">
        <field name="name">view.sale.order.orders.google_map</field>
        <field name="model">sale.order</field>
        <field name="priority" eval="200" />
        <field name="inherit_id" ref="sale_google_map.view_sale_order_quotations_google_map" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//google_map" position="attributes">
                <attribute name="string">Orders</attribute>
                <attribute name="color">#482df7</attribute>
            </xpath>
        </field>
    </record>
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field
            name="view_mode"
            model="ir.actions.act_window"
            eval="','.join(dict.fromkeys(obj(ref('sale.action_orders')).view_mode.split(',') + ['google_map']))"
        />
    </record>
    <record id="sale_order_action_view_google_map" model="ir.actions.act_window.view">
        <field name="sequence" eval="7" />
        <field name="view_mode">google_map</field>
        <field name="view_id" ref="sale_google_map.view_sale_order_orders_google_map" />
        <field name="act_window_id" ref="sale.action_orders" />
    </record>
    <record id="view_sale_order_to_invoice_google_map" model="ir.ui.view">
        <field name="name">view.sale.order.to_invoice.google_map</field>
        <field name="model">sale.order</field>
        <field name="priority" eval="300" />
        <field name="mode">primary</field>
        <field name="inherit_id" ref="sale_google_map.view_sale_order_quotations_google_map" />
        <field name="arch" type="xml">
            <xpath expr="//google_map" position="attributes">
                <attribute name="string">Orders to Invoice</attribute>
                <attribute name="color">#0dbaa9</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_sale_order_upselling_google_map" model="ir.ui.view">
        <field name="name">view.sale.order.upselling.google_map</field>
        <field name="model">sale.order</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <!-- Limit 1, as we grouped per partner_id, so only one record needed to show the marker on the map -->
            <google_map
                js_class="google_map_sale_order"
                limit="1"
                disable_cluster_marker="1"
                default_group_by="partner_id"
                string="Orders to Upsell"
                lat="partner_latitude"
                lng="partner_longitude"
                sidebar_title="name"
                sidebar_subtitle="partner_id"
            >
                <field name="partner_latitude" />
                <field name="partner_longitude" />
                <field name="name" />
                <field name="partner_id" />
                <field name="amount_total" />
            </google_map>
        </field>
    </record>
</odoo>
