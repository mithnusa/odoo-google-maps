<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="crm_google_map.MarkerInfoWindow">
        <div t-attf-class="crm_lead marker-drop-animation #{ this.isSelected ? 'selected-marker' : '' }">
            <div class="marker-icon">
                <span t-if="this.title" class="d-block marker-icon-title mb-1" t-att-data-tooltip="this.title">
                    <small class="font-sans-serif" t-out="this.title" />
                </span>
                <i class="oi oi-fw small" data-icon="label" t-attf-style="color: {{ this.markerColor || 'red' }};" />
                <small t-if="this.stage" class="font-sans-serif" t-out="this.stage" />
                <span t-if="this.expectedRevenue" class="d-block mt-1">
                    <i class="oi oi-fw small text-muted" data-icon="attach_money" />
                    <small class="font-monospace" t-out="this.expectedRevenue" />
                </span>
            </div>
            <div class="marker-content">
                <div class="lead-title">
                    <h4 id="title" class="mb-0" t-out="this.title" />
                    <button id="show-record" class="btn btn-link btn-sm" type="button" data-tooltip="Open">
                        <i class="oi" data-icon="expand_content" />
                    </button>
                </div>
                <hr class="my-2 text-600" />
                <div id="action-buttons" class="btn-group mt-2" role="group" aria-label="Action buttons">
                    <button
                        id="show-scheduled-activities"
                        class="btn btn-sm btn-light"
                        type="button"
                        data-tooltip="Show scheduled activities"
                    >
                        <i class="oi" data-icon="schedule" />
                    </button>
                    <button
                        id="open-schedule-activity"
                        class="btn btn-sm btn-light"
                        type="button"
                        data-tooltip="Schedule an activity"
                    >
                        <i class="oi" data-icon="add" />
                    </button>
                    <button id="show-nearby" class="btn btn-sm btn-light" type="button" data-tooltip="Nearby">
                        <i class="oi" data-icon="near_me" />
                    </button>
                    <button id="show-street-view" class="btn btn-sm btn-light" type="button" data-tooltip="Street View">
                        <i class="oi" data-icon="streetview" />
                    </button>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-2 pt-2 mb-2 pb-1">
                    <div
                        t-if="this.subTitle"
                        class="flex-fill align-content-around px-2 py-1"
                        style="white-space: pre-line; text-align: left; align-items: baseline; gap: 0.25rem;"
                        data-tooltip="Address"
                    >
                        <i
                            class="oi oi-fw"
                            data-icon="push_pin"
                            t-attf-style="color: {{ this.markerColor || 'red' }};"
                        />
                        <span class="small" t-out="this.subTitle" />
                    </div>
                    <div
                        t-if="this.stage"
                        class="flex-fill align-content-around text-center px-2 py-1"
                        data-tooltip="Stage"
                    >
                        <i
                            class="oi d-block"
                            data-icon="label"
                            t-attf-style="color: {{ this.markerColor || 'red' }};"
                        />
                        <span class="small" t-out="this.stage" />
                    </div>
                    <div
                        t-if="this.partnerName"
                        class="flex-fill align-content-around text-center px-2 py-1"
                        data-tooltip="Company Name"
                    >
                        <i
                            class="oi d-block"
                            data-icon="business"
                            t-attf-style="color: {{ this.markerColor || 'red' }};"
                        />
                        <span class="small" t-out="this.partnerName" />
                    </div>
                    <div
                        t-if="this.contactName"
                        class="flex-fill align-content-around text-center px-2 py-1"
                        data-tooltip="Contact"
                    >
                        <i
                            class="oi d-block"
                            data-icon="contact_mail"
                            t-attf-style="color: {{ this.markerColor || 'red' }};"
                        />
                        <span class="small" t-out="this.contactName" />
                    </div>
                    <div
                        t-if="this.phone"
                        class="flex-fill align-content-around text-center px-2 py-1"
                        data-tooltip="Phone"
                    >
                        <i
                            class="oi oi-filled d-block"
                            data-icon="phone"
                            t-attf-style="color: {{ this.markerColor || 'red' }};"
                        />
                        <span class="small" t-out="this.phone" />
                    </div>
                    <div
                        t-if="this.salespersonName"
                        class="flex-fill align-content-around text-center px-2 py-1"
                        data-tooltip="Salesperson"
                    >
                        <i
                            class="oi d-block"
                            data-icon="person"
                            t-attf-style="color: {{ this.markerColor || 'red' }};"
                        />
                        <span class="small" t-out="this.salespersonName" />
                    </div>
                    <div
                        t-if="this.expectedRevenue"
                        class="flex-fill align-content-around text-center px-2 py-1"
                        data-tooltip="Expected Revenue"
                    >
                        <i
                            class="oi d-block"
                            data-icon="attach_money"
                            t-attf-style="color: {{ this.markerColor || 'red' }};"
                        />
                        <span class="font-monospace small" t-out="this.expectedRevenue" />
                    </div>
                    <div
                        t-if="this.probability"
                        class="flex-fill align-content-around text-center px-2 py-1"
                        data-tooltip="Probability"
                    >
                        <i
                            class="oi d-block"
                            data-icon="percent"
                            t-attf-style="color: {{ this.markerColor || 'red' }};"
                        />
                        <span class="small">
                            <t t-out="this.probability" />
                            %
                        </span>
                    </div>
                    <div
                        t-if="this.dateDeadline"
                        class="flex-fill align-content-around text-center px-2 py-1"
                        data-tooltip="Expected Closing"
                    >
                        <i
                            class="oi oi-filled d-block"
                            data-icon="calendar_today"
                            t-attf-style="color: {{ this.markerColor || 'red' }};"
                        />
                        <span class="small" t-out="this.dateDeadline" />
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
