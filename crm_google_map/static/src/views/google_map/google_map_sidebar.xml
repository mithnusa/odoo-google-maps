<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!--
        Extra content rendered below the record title in the sidebar.
        Injected via GoogleMapSidebarCRM.recordExtraTemplate — no xpath needed.
    -->
    <t t-name="crm_google_map.RecordItemExtra">
        <div class="o_crm_sidebar_extra d-flex align-items-center mt-1">
            <div class="o_crm_sidebar_amount d-flex align-items-center">
                <i class="fa fa-dollar text-muted me-1"/>
                <Field id="'expected_revenue'" name="'expected_revenue'" record="record" readonly="true" class="'smaller font-monospace'"/>
            </div>
            <div class="o_crm_sidebar_stage">
                <Field id="'stage_id'" name="'stage_id'" record="record" readonly="true" class="'disabled'"/>
            </div>
        </div>
    </t>
</templates>
