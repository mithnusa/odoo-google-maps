<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_partner_form_inherit_gautocomplete_address_form" model="ir.ui.view">
        <field name="name">view.res.partner.form.inherit.gautocomplete.address.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">3000</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='street']" position="attributes">
                <!-- <attribute name="widget">gplaces_address_autocomplete</attribute> -->
                <attribute name="widget">gplace_autocomplete_el</attribute>
                <attribute name="options">{'mapping_mode': 'address'}</attribute>
                <!-- <attribute name="options">{'mapping_code': 'pQOFA85W'}</attribute> -->
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='name']" position="attributes">
                <attribute name="widget">gplace_autocomplete_el</attribute>
                <attribute name="options">{'mapping_mode': 'places'}</attribute>
                <!-- <attribute name="options">{'mapping_code': 'VeJXBUBi'}</attribute> -->
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='street']" position="attributes">
                <!-- <attribute name="widget">gplaces_address_autocomplete</attribute> -->
                <attribute name="widget">gplace_autocomplete_el</attribute>
                <attribute name="options">{'mapping_mode': 'address'}</attribute>
                <!-- <attribute name="options">{'mapping_code': 'pQOFA85W'}</attribute> -->
            </xpath>
        </field>
    </record>
</odoo>