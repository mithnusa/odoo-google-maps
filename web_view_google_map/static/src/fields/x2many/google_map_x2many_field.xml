<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_view_google_map.X2ManyFieldGoogleMap" t-inherit="web.X2ManyField" t-inherit-mode="primary">
        <xpath expr="//ListRenderer" position="after">
            <GoogleMapRenderer t-elif="this.props.viewMode === 'google_map'" t-props="this.rendererProps" />
        </xpath>
        <xpath expr="//div[@t-custom-ref='buttons']" position="inside">
            <button
                type="button"
                class="btn btn-secondary"
                t-if="this.props.viewMode === 'google_map'"
                data-tooltip="Center Map"
                t-on-click.prevent="() => this.centerMap()"
            >
                <span>Center Map</span>
            </button>
        </xpath>
    </t>
</templates>
