<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_view_google_map.RecordItem">
        <tr t-attf-class="{{ props.allowSelectors &amp;&amp; record.selected ? 'table-info' : '' }}">
            <t t-set="_showMarker" t-value="typeof showMarker === 'boolean' ? showMarker : true" />
            <t t-if="props.allowSelectors">
                <td style="width: 20px;">
                    <CheckBox disabled="!props.handleCanSelectRecord" value="record.selected" onChange.alike="() => this.selectRecord(record)"/>
                </td>
            </t>
            <td class="o_sidebar_content_cell">
                <div class="d-flex gap-2 align-items-center cursor-pointer" t-on-click="() => fnPinPointInMap(record.id)">
                    <div class="o_map_sidebar_record" t-att-data-tooltip="data.other?.title">
                        <Field id="props.title" name="props.title" record="record" readonly="true"/>
                    </div>
                </div>
                <t t-call="{{ constructor.recordExtraTemplate }}"/>
            </td>
            <td>
                <div class="d-flex align-items-center justify-content-center">
                    <span class="pe-1" t-if="_showMarker">
                        <i class="fa fa-map-marker" t-attf-style="color: #{data?.other?.__geoColor || 'red'};" />
                    </span>
                    <button type="button" class="btn btn-sm btn-link" id="action-show-nearby" data-tooltip="Nearby" t-on-click="() => props.showNearbyRecords(record)">
                        <i class="fa fa-location-arrow" />
                    </button>
                    <t t-call="{{ constructor.recordActionsTemplate }}"/>
                    <button type="button" class="btn btn-sm btn-link" id="open-record" data-tooltip="Open" t-on-click.prevent="() => fnOpenRecord(record)">
                        <i class="fa fa-lg fa-angle-right" />
                    </button>
                </div>
            </td>
        </tr>
    </t>
    <t t-name="web_view_google_map.GroupItem">
        <tr>
            <td class="o_sidebar_content_cell" colspan="99">
                <div class="d-flex justify-content-between align-items-center">
                    <button 
                        t-attf-class="btn btn-link #{ group.group.records.length ? '' : 'collapsed'}"
                        t-attf-id="btn-group-collapse-#{group.key}"
                        t-att-data-group_id="group.key"
                        type="button"
                        data-bs-toggle="collapse"
                        t-attf-data-bs-target="#collapseGroup_#{ group.key }"
                        aria-expanded="false"
                        t-attf-aria-controls="collapseGroup_#{ group.key }"
                        t-on-click.prevent="(ev) => this.handleGroupCollapse(ev, group.key)">
                        <div class="d-flex align-items-center o_map_sidebar_group">
                            <t t-set="title" t-value="(group.group.displayName || 'None') + ' (' + group.group.count + ')' " />
                            <span class="me-2">
                                <i class="fa fa-caret-right" />
                                <i class="fa fa-caret-down" />
                            </span>
                            <span class="ps-1 pe-1" t-out="title" t-att-data-tooltip="title"/>
                        </div>
                    </button>
                    <div t-if="group.group.count" class="d-flex align-items-center justify-content-center">
                        <span class="me-1">
                            <i class="fa fa-map-marker" t-attf-style="color: #{group.group.groupColor || 'red'};" />
                        </span>
                        <button type="button" class="btn btn-sm btn-link" data-tooltip="Open" t-on-click="() => this.actionShowGroupRecords(group)">
                            <i class="fa fa-lg fa-angle-double-right" />
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="o_sidebar_content_cell" colspan="99" style="padding: 0; border: 0;">
                <div t-attf-class="collapse #{ group.group.records.length ? 'show' : '' }" t-attf-id="collapseGroup_#{ group.key }">
                    <t t-if="group.group.records.length">
                        <table class="table table-sm table-hover table-striped mb-0">
                            <tbody>
                                <t t-foreach="group.group.records" t-as="record" t-key="record.id">
                                    <t t-call="{{ constructor.recordItemTemplate }}">
                                        <t t-set="record" t-value="record" />
                                        <t t-set="data" t-value="record.dataView" />
                                        <t t-set="showMarker" t-value="false" />
                                    </t>
                                </t>
                                <tr t-if="group.group.count > group.group.records.length">
                                    <td colspan="99">
                                        <div class="text-center cursor-pointer" role="button" t-on-click.prevent="() => this.actionShowGroupRecords(group)">
                                            <span class="me-2">see more</span>
                                            <i class="fa fa-fw fa-lg fa-angle-double-right" />
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </td>
        </tr>
    </t>
    <t t-name="web_view_google_map.ListGroupOrRecord">
        <table class="table table-sm table-hover table-striped">
            <tbody>
                <t t-if="datas.length">
                    <t t-foreach="datas" t-as="groupOrRecord" t-key="groupOrRecord.key">
                        <t t-if="groupOrRecord.group">
                            <t t-call="{{ constructor.groupItemTemplate }}">
                                <t t-set="group" t-value="groupOrRecord" />
                            </t>
                        </t>
                        <t t-else="">
                            <t t-call="{{ constructor.recordItemTemplate }}">
                                <t t-set="record" t-value="groupOrRecord.record" />
                                <t t-set="data" t-value="record.dataView" />
                            </t>
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <tr>
                        <td colspan="99">
                            <div class="d-flex flex-column align-items-center">
                                <h5>No data available to display</h5>
                                <small class="text-muted">Please ensure geolocation data is set</small>
                            </div>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </t>
    <!--
        Empty slot rendered below the record title inside the content <td>.
        Override `recordExtraTemplate` in a sub-class to inject extra fields
        (amount, stage, etc.) without touching the RecordItem template.
    -->
    <t t-name="web_view_google_map.RecordItemExtra"/>
    <!--
        Empty slot rendered inside the actions <td>, between the Nearby button
        and the Open button.  Override `recordActionsTemplate` in a sub-class
        to inject extra action buttons (e.g. View Tasks) without touching the
        RecordItem template.
    -->
    <t t-name="web_view_google_map.RecordActionsTemplate"/>

    <t t-name="web_view_google_map.GoogleMapSidebar">
        <div class="o_map_sidebar" t-ref="root">
            <div class="mt-2 mx-1">
                <div class="d-flex">
                    <t t-if="props.allowSelectors">
                        <CheckBox value="props.handleSelectAll" onChange.bind="props.handleToggleSelection"/>
                    </t>
                    <h3 t-if="props.header" t-esc="props.header" />
                    <small class="ms-2 text-muted">
                        <span data-tooltip="Only records with geolocation data set are displayed">
                            <i class="fa fa-info" />
                        </span>
                    </small>
                </div>
            </div>
            <t t-call="{{ constructor.listGroupOrRecordTemplate }}">
                <t t-set="fnPinPointInMap" t-value="props.pointInMap" />
                <t t-set="fnOpenRecord" t-value="props.openRecord" />
            </t>
        </div>
    </t>
</templates>
