<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!--
        Sub-templates are rendered via parametric t-call: `record`, `data`,
        `showMarker`, `group`, `fnPinPointInMap` and `fnOpenRecord` are t-call
        parameters and must be read as bare variables (OWL 3 does not expose
        them on `this`, and nested t-calls must re-pass them explicitly).
    -->
    <t t-name="web_view_google_map.RecordItem">
        <tr t-att-class="{ 'table-info': this.props.allowSelectors &amp;&amp; record.selected }">
            <t t-set="_showMarker" t-value="showMarker ?? true" />
            <t t-if="this.props.allowSelectors">
                <td style="width: 20px;">
                    <CheckBox
                        disabled="!this.props.handleCanSelectRecord"
                        value="record.selected"
                        onChange.alike="() => this.selectRecord(record)"
                    />
                </td>
            </t>
            <td class="o_sidebar_content_cell">
                <div
                    class="d-flex gap-2 align-items-center cursor-pointer"
                    t-on-click="() => fnPinPointInMap(record.resId)"
                >
                    <div class="o_map_sidebar_record" t-att-data-tooltip="data?.other?.title">
                        <Field id="this.props.title" name="this.props.title" record="record" readonly="true" />
                    </div>
                </div>
                <t t-call="{{ this.constructor.recordExtraTemplate }}" record="record" data="data" />
            </td>
            <td>
                <div class="d-flex align-items-center justify-content-center">
                    <span class="pe-1" t-if="_showMarker">
                        <i
                            class="fa fa-map-marker"
                            aria-hidden="true"
                            t-attf-style="color: #{data?.other?.__geoColor || 'red'};"
                        />
                    </span>
                    <button
                        type="button"
                        class="btn btn-sm btn-link"
                        data-role="action-show-nearby"
                        data-tooltip="Nearby"
                        t-on-click="() => this.props.showNearbyRecords(record)"
                    >
                        <i class="fa fa-location-arrow" aria-hidden="true" />
                    </button>
                    <t t-call="{{ this.constructor.recordActionsTemplate }}" record="record" data="data" />
                    <button
                        type="button"
                        class="btn btn-sm btn-link"
                        data-role="open-record"
                        data-tooltip="Open"
                        t-on-click.prevent="() => fnOpenRecord(record)"
                    >
                        <i class="fa fa-lg fa-angle-right" aria-hidden="true" />
                    </button>
                </div>
            </td>
        </tr>
    </t>
    <t t-name="web_view_google_map.GroupItem">
        <tr>
            <td class="o_sidebar_content_cell" colspan="99">
                <div class="d-flex justify-content-between align-items-center">
                    <button
                        t-att-class="{ 'btn': true, 'btn-link': true, 'collapsed': !group.group.records.length }"
                        t-attf-id="btn-group-collapse-#{group.key}"
                        t-att-data-group_id="group.key"
                        type="button"
                        data-bs-toggle="collapse"
                        t-attf-data-bs-target="#collapseGroup_#{ group.key }"
                        t-att-aria-expanded="group.group.records.length ? 'true' : 'false'"
                        t-attf-aria-controls="collapseGroup_#{ group.key }"
                        t-on-click.prevent="(ev) => this.handleGroupCollapse(ev, group.key)"
                    >
                        <div class="d-flex align-items-center o_map_sidebar_group">
                            <t t-set="title" t-value="this.getGroupTitle(group)" />
                            <span class="me-2">
                                <i class="fa fa-caret-right" aria-hidden="true" />
                                <i class="fa fa-caret-down" aria-hidden="true" />
                            </span>
                            <span class="ps-1 pe-1" t-out="title" t-att-data-tooltip="title" />
                        </div>
                    </button>
                    <div t-if="group.group.count" class="d-flex align-items-center justify-content-center">
                        <span class="me-1">
                            <i
                                class="fa fa-map-marker"
                                aria-hidden="true"
                                t-attf-style="color: #{group.group.groupColor || 'red'};"
                            />
                        </span>
                        <button
                            type="button"
                            class="btn btn-sm btn-link"
                            data-tooltip="Open"
                            t-on-click="() => this.actionShowGroupRecords(group)"
                        >
                            <i class="fa fa-lg fa-angle-double-right" aria-hidden="true" />
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="o_sidebar_content_cell" colspan="99" style="padding: 0; border: 0;">
                <div
                    t-att-class="{ 'collapse': true, 'show': !!group.group.records.length }"
                    t-attf-id="collapseGroup_#{ group.key }"
                >
                    <t t-if="group.group.records.length">
                        <table class="table table-sm table-hover table-striped mb-0">
                            <tbody>
                                <t t-foreach="group.group.records" t-as="record" t-key="record.id">
                                    <t t-call="{{ this.constructor.recordItemTemplate }}"
                                        record="record"
                                        data="record.dataView"
                                        showMarker="false"
                                        fnPinPointInMap="fnPinPointInMap"
                                        fnOpenRecord="fnOpenRecord"/>
                                </t>
                                <tr t-if="group.group.count > group.group.records.length">
                                    <td colspan="99">
                                        <div
                                            class="text-center cursor-pointer"
                                            role="button"
                                            t-on-click.prevent="() => this.actionShowGroupRecords(group)"
                                        >
                                            <span class="me-2">see more</span>
                                            <i class="fa fa-fw fa-lg fa-angle-double-right" aria-hidden="true" />
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </td>
        </tr>
    </t>
    <t t-name="web_view_google_map.ListGroupOrRecord">
        <table class="table table-sm table-hover table-striped">
            <tbody>
                <t t-if="this.datas.length">
                    <t t-foreach="this.datas" t-as="groupOrRecord" t-key="groupOrRecord.key">
                        <t t-if="groupOrRecord.group">
                            <t t-call="{{ this.constructor.groupItemTemplate }}"
                                group="groupOrRecord"
                                fnPinPointInMap="fnPinPointInMap"
                                fnOpenRecord="fnOpenRecord"/>
                        </t>
                        <t t-else="">
                            <t t-set="record" t-value="groupOrRecord.record" />
                            <t t-call="{{ this.constructor.recordItemTemplate }}"
                                record="record"
                                data="record.dataView"
                                fnPinPointInMap="fnPinPointInMap"
                                fnOpenRecord="fnOpenRecord"/>
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <tr>
                        <td colspan="99">
                            <div class="d-flex flex-column align-items-center">
                                <h5>No data available to display</h5>
                                <small class="text-muted">Please ensure geolocation data is set</small>
                            </div>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </t>
    <!--
        Empty slot rendered below the record title inside the content <td>.
        Override `recordExtraTemplate` in a sub-class to inject extra fields
        (amount, stage, etc.) without touching the RecordItem template.
    -->
    <t t-name="web_view_google_map.RecordItemExtra" />
    <!--
        Empty slot rendered inside the actions <td>, between the Nearby button
        and the Open button.  Override `recordActionsTemplate` in a sub-class
        to inject extra action buttons (e.g. View Tasks) without touching the
        RecordItem template.
    -->
    <t t-name="web_view_google_map.RecordActionsTemplate" />

    <t t-name="web_view_google_map.GoogleMapSidebar">
        <div class="o_map_sidebar" t-custom-ref="root">
            <div class="mt-2 mx-1">
                <div class="d-flex">
                    <t t-if="this.props.allowSelectors">
                        <CheckBox value="this.props.handleSelectAll" onChange.bind="this.props.handleToggleSelection" />
                    </t>
                    <h3 t-if="this.props.header" t-out="this.props.header" />
                    <small class="ms-2 text-muted">
                        <span t-att-data-tooltip="this.geolocationInfoTooltip">
                            <i class="fa fa-info" aria-hidden="true" />
                        </span>
                    </small>
                </div>
            </div>
            <div t-if="this.props.unLocatedCount &gt; 0" class="py-1 border-top border-bottom">
                <div class="d-flex align-items-center justify-content-end px-1">
                    <div>
                        <span>Unlocated</span>
                        <span class="ms-1">
                            (<t t-out="this.props.unLocatedCount" />)
                        </span>
                    </div>
                    <button
                        type="button"
                        class="btn btn-link"
                        data-tooltip="Show Unlocated"
                        t-on-click.prevent="() => this.props.showUnlocatedRecords()"
                    >
                        <i class="fa fa-lg fa-angle-double-right" aria-hidden="true" />
                    </button>
                </div>
            </div>
            <t t-call="{{ this.constructor.listGroupOrRecordTemplate }}"
                fnPinPointInMap="this.props.pointInMap"
                fnOpenRecord="this.props.openRecord"/>
        </div>
    </t>
</templates>
