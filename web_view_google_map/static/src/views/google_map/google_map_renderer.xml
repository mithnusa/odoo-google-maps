<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_view_google_map.GoogleMapRenderer">
        <div class="o_google_map_renderer">
            <Geolocate googleMap="googleMap"/>
            <div class="o_google_map_view" t-ref="map"></div>
            <InMapSearchPlaces googleMap="googleMap"/>
            <div t-attf-class="o_map_right_sidebar #{state.sidebarIsFolded ? 'closed': 'open'}">
                <div class="content">
                    <Sidebar t-props="sidebarProps"/>
                </div>
                <div class="toggle_right_sidenav">
                    <button data-toggle="tooltip" data-placement="right" title="Expand side panel" t-on-click="toggleSidebar"></button>
                </div>
            </div>
        </div>
    </t>
    <t t-name="web_view_google_map.MarkerInfoWindow">
        <div class="infoWindow">
            <hr t-if="isMulti"/>
            <div class="d-flex flex-grow-1 flex-md-shrink-1 flex-shrink-0">
                <div class="o_kanban_record d-flex">
                    <div class="oe_kanban_card d-flex flex-column">
                        <div class="d-flex o_kanban_header">
                        </div>
                        <div class="oe_kanban_details d-flex flex-column justify-content-between pt-3">
                            <div class="o_kanban_record_title">
                                <a href="#" role="button" class="text-decoration-none" id="btn-open_form" tabindex="-1">
                                    <h4 t-esc="title"/>
                                </a>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <t t-esc="subTitle"/>
                            </div>
                        </div>
                        <div class="pt-3 d-flex text-nowrap justify-content-between gap-1">
                            <a t-attf-href="https://www.google.com/maps/dir/?api=1&amp;destination={{ destination }}" target="_blank" tabindex="-1" class="btn btn-sm btn-secondary" id="btn-navigate_to" data-toggle="tooltip" title="Navigate to this location">
                                <i class="fa fa-map-signs"></i>
                                <span class="ps-1 fw-light smaller">Navigate to</span>
                            </a>
                            <a t-attf-href="https://www.google.com/maps/search/?api=1&amp;query={{ destination }}" target="_blank" tabindex="-1" class="btn btn-sm btn-secondary" id="btn-view-on-googlemaps" data-toggle="tooltip" title="View on Google Maps website">
                                <i class="fa fa-external-link"></i>
                                <span class="ps-1 fw-light smaller">View on Google Maps</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
