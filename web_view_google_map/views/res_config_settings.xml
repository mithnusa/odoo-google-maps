<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base_google_map</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="1000"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='base_google_map']" position="inside">
                <setting id="nearby_radius_search_setting" help="Set the default radius for nearby search in Google Maps. The radius is specified in meters, and must be a positive integer. The default value is 1000 meters (1 kilometer).">
                    <field name="nearby_radius_search" string="Nearby Search Radius (m)"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>