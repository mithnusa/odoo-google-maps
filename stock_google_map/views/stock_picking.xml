<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_stock_picking_google_map" model="ir.ui.view">
        <field name="name">view.stock.picking.google_map</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <google_map
                string="Locations"
                lat="partner_latitude"
                lng="partner_longitude"
                sidebar_title="name"
                sidebar_subtitle="partner_contact_address"
                color="teal"
            >
                <field name="partner_latitude" />
                <field name="partner_longitude" />
                <field name="name" />
                <field name="partner_contact_address" />
            </google_map>
        </field>
    </record>
    <!-- Deliveries -->
    <record id="stock.action_picking_tree_outgoing" model="ir.actions.act_window">
        <field
            name="view_mode"
            model="ir.actions.act_window"
            eval="','.join(dict.fromkeys(obj(ref('stock.action_picking_tree_outgoing')).view_mode.split(',') + ['google_map']))"
        />
    </record>
    <!-- To Do -->
    <record id="stock.action_picking_tree_ready" model="ir.actions.act_window">
        <field
            name="view_mode"
            model="ir.actions.act_window"
            eval="','.join(dict.fromkeys(obj(ref('stock.action_picking_tree_ready')).view_mode.split(',') + ['google_map']))"
        />
    </record>
    <record id="stock.action_picking_tree_graph" model="ir.actions.act_window">
        <field
            name="view_mode"
            model="ir.actions.act_window"
            eval="','.join(dict.fromkeys(obj(ref('stock.action_picking_tree_graph')).view_mode.split(',') + ['google_map']))"
        />
    </record>
    <!-- Waiting Transfer -->
    <record id="stock.action_picking_tree_waiting" model="ir.actions.act_window">
        <field
            name="view_mode"
            model="ir.actions.act_window"
            eval="','.join(dict.fromkeys(obj(ref('stock.action_picking_tree_waiting')).view_mode.split(',') + ['google_map']))"
        />
    </record>
    <!-- Late Transfer -->
    <record id="stock.action_picking_tree_late" model="ir.actions.act_window">
        <field
            name="view_mode"
            model="ir.actions.act_window"
            eval="','.join(dict.fromkeys(obj(ref('stock.action_picking_tree_late')).view_mode.split(',') + ['google_map']))"
        />
    </record>
    <!-- Backorders -->
    <record id="stock.action_picking_tree_backorder" model="ir.actions.act_window">
        <field
            name="view_mode"
            model="ir.actions.act_window"
            eval="','.join(dict.fromkeys(obj(ref('stock.action_picking_tree_backorder')).view_mode.split(',') + ['google_map']))"
        />
    </record>
</odoo>
