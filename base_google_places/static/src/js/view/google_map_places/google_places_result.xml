<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="base_google_places.PlacesResult" owl="1">
        <div class="mt-3" t-ref="root">
            <t t-if="!isEmpty">
                <div class="list-group mb-5">
                    <t t-foreach="props.places" t-as="place" t-key="place.place_id">
                        <GooglePlacesItem place="place" handlePointInMap.bind="handleClickItem" handleAdd.bind="handleClickItemAdd"/>
                    </t>
                </div>
                <div class="d-flex w-100" style="bottom: 0; position: fixed; padding: 2px; z-index: 10;">
                    <button type="button" class="btn btn-info btn-block o_hidden" id="search-more">Next page</button>
                </div>
            </t>
            <t t-else="">
                <div class="container text-center">
                    <div class="row">
                        <p class="text-muted">No places found<br/>
Enter your search keyword</p>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>