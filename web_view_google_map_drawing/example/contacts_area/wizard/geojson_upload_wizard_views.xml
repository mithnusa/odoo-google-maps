<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- GeoJSON Upload Wizard Form View -->
    <record id="view_geojson_upload_wizard_form" model="ir.ui.view">
        <field name="name">geojson.upload.wizard.form</field>
        <field name="model">google.geojson.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Import GeoJSON File">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Import Name..." required="1" />
                        </h1>
                    </div>

                    <group>
                        <group name="file_upload">
                            <field
                                name="geojson_file"
                                filename="filename"
                                required="1"
                                options="{'accepted_file_extensions': '.geojson,.json,application/geo+json,application/json'}"
                            />
                            <field name="filename" invisible="1" />
                            <field name="target_model" readonly="1" />
                        </group>

                        <group name="import_options">
                            <field name="feature_name" />
                            <field name="overwrite_existing" />
                        </group>
                    </group>

                    <group name="description">
                        <field
                            name="default_description"
                            placeholder="Enter default description for imported features..."
                        />
                    </group>

                    <notebook>
                        <page string="Preview" name="preview">
                            <group>
                                <field name="feature_count" readonly="1" />
                            </group>
                            <field name="preview_data" readonly="1" widget="text" />
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button name="action_import_geojson" string="Import Features" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <!-- GeoJSON Upload Wizard Action -->
    <record id="action_geojson_upload_wizard" model="ir.actions.act_window">
        <field name="name">Import GeoJSON File</field>
        <field name="res_model">google.geojson.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
