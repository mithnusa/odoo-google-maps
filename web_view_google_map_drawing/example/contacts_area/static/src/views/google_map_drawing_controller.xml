<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web_view_google_map_drawing.GoogleMapView.Buttons" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='centerMap']" position="after">
            <button type="button" t-if="props.resModel == 'res.partner.area' and !editedRecord and activeActions.create and props.showButtons" class="btn btn-outline-primary o-google_map-button-draw-shapes" t-on-click="openGeoJSONUploadWizard" data-tooltip="Import GeoJSON file">
                <i class="fa fa-upload"/>
                <span class="ps-1">GeoJSON</span>
            </button>
        </xpath>
    </t>
</templates>