<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!-- Nebula.gl Editor Template -->
    <t t-name="nebula_gl_editor_template">
        <div class="nebula-gl-editor" t-ref="nebula-editor">
            <!-- Drawing Tools Toolbar -->
            <div class="nebula-toolbar" t-if="!props.readonly">
                <div class="toolbar-section drawing-tools">
                    <h6 class="toolbar-title">Drawing Tools</h6>
                    <div class="tool-buttons">
                        <!-- Select Tool -->
                        <button 
                            class="tool-btn" 
                            t-att-class="state.currentTool === 'select' ? 'active' : ''"
                            t-on-click="() => this.setMode('select')"
                            title="Select and Edit Features (V)">
                            <i class="fa fa-mouse-pointer"></i>
                        </button>
                        
                        <!-- Point Tool -->
                        <button 
                            class="tool-btn" 
                            t-att-class="state.currentTool === 'point' ? 'active' : ''"
                            t-on-click="() => this.setMode('point')"
                            title="Draw Point (P)">
                            <i class="fa fa-map-pin"></i>
                        </button>
                        
                        <!-- Line Tool -->
                        <button 
                            class="tool-btn" 
                            t-att-class="state.currentTool === 'line' ? 'active' : ''"
                            t-on-click="() => this.setMode('line')"
                            title="Draw Line (L)">
                            <i class="fa fa-minus"></i>
                        </button>
                        
                        <!-- Polygon Tool -->
                        <button 
                            class="tool-btn" 
                            t-att-class="state.currentTool === 'polygon' ? 'active' : ''"
                            t-on-click="() => this.setMode('polygon')"
                            title="Draw Polygon (O)">
                            <i class="fa fa-draw-polygon"></i>
                        </button>
                        
                        <!-- Rectangle Tool -->
                        <button 
                            class="tool-btn" 
                            t-att-class="state.currentTool === 'rectangle' ? 'active' : ''"
                            t-on-click="() => this.setMode('rectangle')"
                            title="Draw Rectangle (R)">
                            <i class="fa fa-square-o"></i>
                        </button>
                        
                        <!-- Circle Tool -->
                        <button 
                            class="tool-btn" 
                            t-att-class="state.currentTool === 'circle' ? 'active' : ''"
                            t-on-click="() => this.setMode('circle')"
                            title="Draw Circle (C)">
                            <i class="fa fa-circle-o"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Editing Tools -->
                <div class="toolbar-section editing-tools">
                    <h6 class="toolbar-title">Edit Tools</h6>
                    <div class="tool-buttons">
                        <!-- Modify Tool -->
                        <button 
                            class="tool-btn" 
                            t-att-class="state.currentTool === 'modify' ? 'active' : ''"
                            t-on-click="() => this.setMode('modify')"
                            title="Modify Feature Shape (M)">
                            <i class="fa fa-edit"></i>
                        </button>
                        
                        <!-- Move Tool -->
                        <button 
                            class="tool-btn" 
                            t-att-class="state.currentTool === 'translate' ? 'active' : ''"
                            t-on-click="() => this.setMode('translate')"
                            title="Move Feature (T)">
                            <i class="fa fa-arrows"></i>
                        </button>
                        
                        <!-- Rotate Tool -->
                        <button 
                            class="tool-btn" 
                            t-att-class="state.currentTool === 'rotate' ? 'active' : ''"
                            t-on-click="() => this.setMode('rotate')"
                            title="Rotate Feature (Y)">
                            <i class="fa fa-rotate-right"></i>
                        </button>
                        
                        <!-- Scale Tool -->
                        <button 
                            class="tool-btn" 
                            t-att-class="state.currentTool === 'scale' ? 'active' : ''"
                            t-on-click="() => this.setMode('scale')"
                            title="Scale Feature (S)">
                            <i class="fa fa-expand-arrows-alt"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Action Tools -->
                <div class="toolbar-section action-tools">
                    <h6 class="toolbar-title">Actions</h6>
                    <div class="tool-buttons">
                        <!-- Undo -->
                        <button 
                            class="tool-btn" 
                            t-att-disabled="!this.getStats().canUndo"
                            t-on-click="() => this.undo()"
                            title="Undo (Ctrl+Z)">
                            <i class="fa fa-undo"></i>
                        </button>
                        
                        <!-- Redo -->
                        <button 
                            class="tool-btn" 
                            t-att-disabled="!this.getStats().canRedo"
                            t-on-click="() => this.redo()"
                            title="Redo (Ctrl+Y)">
                            <i class="fa fa-redo"></i>
                        </button>
                        
                        <!-- Delete Selected -->
                        <button 
                            class="tool-btn danger" 
                            t-att-disabled="state.selectedFeatureIds.size === 0"
                            t-on-click="() => this.deleteSelectedFeatures()"
                            title="Delete Selected (Del)">
                            <i class="fa fa-trash"></i>
                        </button>
                        
                        <!-- Clear All -->
                        <button 
                            class="tool-btn danger" 
                            t-att-disabled="state.features.length === 0"
                            t-on-click="() => this.clear()"
                            title="Clear All Features">
                            <i class="fa fa-trash-o"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Status Bar -->
            <div class="nebula-status-bar">
                <div class="status-section">
                    <div class="status-item">
                        <i class="fa fa-layer-group"></i>
                        <span>Features: <strong t-esc="state.featureCount"></strong></span>
                    </div>
                    <div class="status-item">
                        <i class="fa fa-dot-circle-o"></i>
                        <span>Vertices: <strong t-esc="state.totalVertices"></strong></span>
                    </div>
                    <div class="status-item">
                        <i class="fa fa-check-square-o"></i>
                        <span>Selected: <strong t-esc="state.selectedFeatureIds.size"></strong></span>
                    </div>
                </div>
                
                <div class="status-section">
                    <div class="status-item">
                        <i class="fa fa-tools"></i>
                        <span>Mode: <strong t-esc="state.currentTool"></strong></span>
                    </div>
                    <div class="status-item" t-if="state.isDirty">
                        <i class="fa fa-circle text-warning"></i>
                        <span>Unsaved Changes</span>
                    </div>
                    <div class="status-item" t-if="state.showMeasurements">
                        <i class="fa fa-ruler"></i>
                        <span>Measurements: <strong t-esc="state.measurementUnit"></strong></span>
                    </div>
                </div>
            </div>
            
            <!-- Real-time Measurement Display -->
            <div class="nebula-measurement-overlay" t-if="state.currentMeasurement and state.showMeasurements">
                <div class="measurement-popup">
                    <i class="fa fa-ruler-combined"></i>
                    <span t-esc="state.currentMeasurement.display"></span>
                </div>
            </div>
            
            <!-- Drawing Instructions -->
            <div class="nebula-instructions" t-if="state.isDrawing">
                <div class="instructions-popup">
                    <div class="instructions-content">
                        <h6>Drawing <t t-esc="state.currentTool.charAt(0).toUpperCase() + state.currentTool.slice(1)"></t></h6>
                        <ul>
                            <li t-if="state.currentTool === 'point'">Click to place a point</li>
                            <li t-if="state.currentTool === 'line'">Click to start, click to add points, double-click to finish</li>
                            <li t-if="state.currentTool === 'polygon'">Click to start, click to add points, double-click to close polygon</li>
                            <li t-if="state.currentTool === 'rectangle'">Click and drag to draw rectangle</li>
                            <li t-if="state.currentTool === 'circle'">Click center, then click edge to set radius</li>
                        </ul>
                        <p><kbd>Esc</kbd> to cancel | <kbd>Enter</kbd> to finish</p>
                    </div>
                </div>
            </div>
            
            <!-- Performance Warning -->
            <div class="nebula-performance-info" t-if="state.totalVertices > 10000">
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i>
                    <strong>High Performance Mode:</strong> 
                    Handling <t t-esc="state.totalVertices.toLocaleString()"></t> vertices with GPU acceleration.
                    Terra Draw would have frozen with this complexity!
                </div>
            </div>
        </div>
    </t>
</templates>