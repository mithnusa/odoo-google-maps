<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="nebula_map_editor_template">
        <div class="nebula-map-editor" t-ref="nebula-editor">
            <!-- Toolbar -->
            <div class="nebula-toolbar" t-if="!props.readonly">
                <div class="toolbar-section">
                    <button 
                        class="tool-btn" 
                        t-att-class="state.currentTool === 'select' ? 'active' : ''"
                        t-on-click="() => this.setTool('select')"
                        title="Select (V)">
                        <i class="fa fa-mouse-pointer"></i>
                    </button>
                    
                    <button 
                        class="tool-btn" 
                        t-att-class="state.currentTool === 'point' ? 'active' : ''"
                        t-on-click="() => this.setTool('point')"
                        title="Point (P)">
                        <i class="fa fa-map-pin"></i>
                    </button>
                    
                    <button 
                        class="tool-btn" 
                        t-att-class="state.currentTool === 'line' ? 'active' : ''"
                        t-on-click="() => this.setTool('line')"
                        title="Line (L)">
                        <i class="fa fa-minus"></i>
                    </button>
                    
                    <button 
                        class="tool-btn" 
                        t-att-class="state.currentTool === 'polygon' ? 'active' : ''"
                        t-on-click="() => this.setTool('polygon')"
                        title="Polygon (O)">
                        <i class="fa fa-draw-polygon"></i>
                    </button>
                    
                    <button 
                        class="tool-btn" 
                        t-att-class="state.currentTool === 'rectangle' ? 'active' : ''"
                        t-on-click="() => this.setTool('rectangle')"
                        title="Rectangle (R)">
                        <i class="fa fa-square-o"></i>
                    </button>
                    
                    <button 
                        class="tool-btn" 
                        t-att-class="state.currentTool === 'circle' ? 'active' : ''"
                        t-on-click="() => this.setTool('circle')"
                        title="Circle (C)">
                        <i class="fa fa-circle-o"></i>
                    </button>
                </div>
                
                <div class="toolbar-divider"></div>
                
                <div class="toolbar-section">
                    <button 
                        class="tool-btn" 
                        t-att-class="state.currentTool === 'modify' ? 'active' : ''"
                        t-on-click="() => this.setTool('modify')"
                        title="Edit (M)">
                        <i class="fa fa-edit"></i>
                    </button>
                    
                    <button 
                        class="tool-btn" 
                        t-att-disabled="!this.getStats().canUndo"
                        t-on-click="() => this.undo()"
                        title="Undo (Ctrl+Z)">
                        <i class="fa fa-undo"></i>
                    </button>
                    
                    <button 
                        class="tool-btn" 
                        t-att-disabled="!this.getStats().canRedo"
                        t-on-click="() => this.redo()"
                        title="Redo (Ctrl+Y)">
                        <i class="fa fa-redo"></i>
                    </button>
                    
                    <button 
                        class="tool-btn danger" 
                        t-att-disabled="state.selectedFeatureIds.size === 0"
                        t-on-click="() => this.deleteSelected()"
                        title="Delete (Del)">
                        <i class="fa fa-trash"></i>
                    </button>
                    
                    <button 
                        class="tool-btn danger" 
                        t-att-disabled="state.features.length === 0"
                        t-on-click="() => this.clear()"
                        title="Clear All">
                        <i class="fa fa-trash-o"></i>
                    </button>
                </div>
            </div>
            
            <!-- Status Bar -->
            <div class="nebula-status">
                <span><i class="fa fa-layer-group"></i> Features: <strong t-esc="state.featureCount"></strong></span>
                <span><i class="fa fa-dot-circle-o"></i> Vertices: <strong t-esc="state.totalVertices"></strong></span>
                <span><i class="fa fa-tools"></i> Tool: <strong t-esc="state.currentTool"></strong></span>
                
                <span t-if="state.totalVertices > 1000" class="performance-badge">
                    <i class="fa fa-rocket"></i> High-Performance Mode
                </span>
            </div>
            
            <!-- Drawing Instructions -->
            <div class="nebula-instructions" t-if="state.isDrawing">
                <div class="instruction-card">
                    <h6>Drawing <t t-esc="state.currentTool.charAt(0).toUpperCase() + state.currentTool.slice(1)"></t></h6>
                    <p t-if="state.currentTool === 'point'">Click to place a point</p>
                    <p t-if="state.currentTool === 'line'">Click to start, click to add points, double-click to finish</p>
                    <p t-if="state.currentTool === 'polygon'">Click to start, click to add points, double-click to close</p>
                    <p t-if="state.currentTool === 'rectangle'">Click and drag to draw rectangle</p>
                    <p t-if="state.currentTool === 'circle'">Click center, then click edge to set radius</p>
                    <small><kbd>Esc</kbd> to cancel</small>
                </div>
            </div>
        </div>
    </t>
</templates>