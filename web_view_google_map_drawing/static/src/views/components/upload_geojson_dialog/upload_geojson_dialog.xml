<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_view_google_map_drawing.UploadGeoJsonFileDialog">
        <Dialog size="'md'" title="props.title" modalRef="modalRef">
            <div class="alert alert-warning" role="alert">
                Any existing drawn features will be removed when importing a new GeoJSON file
            </div>
            <div class="row">
                <div class="col">
                    <input
                        class="form-control"
                        type="file"
                        id="geojson-file"
                        accept=".geojson,.json,application/geo+json,application/json"
                    />
                    <small class="d-block mt-1 text-muted">Maximum file size: 5 MB</small>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="_confirm" t-esc="props.confirmLabel" data-hotkey="q" />
                <button
                    t-if="props.cancel"
                    class="btn btn-secondary"
                    t-on-click="_cancel"
                    t-esc="props.cancelLabel"
                    data-hotkey="x"
                />
            </t>
        </Dialog>
    </t>
</templates>
