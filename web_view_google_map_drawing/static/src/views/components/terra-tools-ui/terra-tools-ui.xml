<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_view_google_map_drawing.TerraToolsUI">
        <!-- Main Toolbar -->
        <div class="o_terra_tools_ui" t-ref="toolUiRef">
            <div class="o_terra_toolbar">
                <button
                    id="point-mode"
                    t-att-class="{ 'mode-button': true, 'active': state.activeButton === 'point-mode' }"
                    data-tooltip="Point"
                    t-on-click.prevent="onClickSetActiveMode"
                >
                    <img src="/web_view_google_map_drawing/static/img/point.svg" alt="Point" draggable="false" />
                </button>
                <button
                    id="linestring-mode"
                    t-att-class="{ 'mode-button': true, 'active': state.activeButton === 'linestring-mode' }"
                    data-tooltip="Linestring"
                    t-on-click.prevent="onClickSetActiveMode"
                >
                    <img
                        src="/web_view_google_map_drawing/static/img/polyline.svg"
                        alt="Linestring"
                        draggable="false"
                    />
                </button>
                <button
                    id="polygon-mode"
                    t-att-class="{ 'mode-button': true, 'active': state.activeButton === 'polygon-mode' }"
                    data-tooltip="Polygon"
                    t-on-click.prevent="onClickSetActiveMode"
                >
                    <img src="/web_view_google_map_drawing/static/img/polygon.png" alt="Polygon" draggable="false" />
                </button>
                <button
                    id="rectangle-mode"
                    t-att-class="{ 'mode-button': true, 'active': state.activeButton === 'rectangle-mode' }"
                    data-tooltip="Rectangle"
                    t-on-click.prevent="onClickSetActiveMode"
                >
                    <img
                        src="/web_view_google_map_drawing/static/img/rectangle.svg"
                        alt="Rectangle"
                        draggable="false"
                    />
                </button>
                <button
                    id="circle-mode"
                    t-att-class="{ 'mode-button': true, 'active': state.activeButton === 'circle-mode' }"
                    data-tooltip="Circle"
                    t-on-click.prevent="onClickSetActiveMode"
                >
                    <img src="/web_view_google_map_drawing/static/img/circle.svg" alt="Circle" draggable="false" />
                </button>
                <button
                    id="freehand-mode"
                    t-att-class="{ 'mode-button': true, 'active': state.activeButton === 'freehand-mode' }"
                    data-tooltip="Freehand"
                    t-on-click.prevent="onClickSetActiveMode"
                >
                    <img src="/web_view_google_map_drawing/static/img/freehand.svg" alt="Freehand" draggable="false" />
                </button>
                <button
                    id="select-mode"
                    t-att-class="{ 'mode-button': true, 'active': state.activeButton === 'select-mode' }"
                    data-tooltip="Select"
                    t-on-click.prevent="onClickSetActiveMode"
                >
                    <img src="/web_view_google_map_drawing/static/img/select.svg" alt="Select" draggable="false" />
                </button>
                <button
                    id="resize-button"
                    t-att-class="{ 'mode-button': true, 'active': state.resizingEnabled }"
                    data-tooltip="Resize"
                    t-on-click.prevent="onClickActionButton"
                >
                    <img src="/web_view_google_map_drawing/static/img/resize.svg" alt="Resize" draggable="false" />
                </button>
                <button
                    id="clear-mode"
                    t-att-class="{ 'mode-button': true, 'active': state.activeButton === 'clear-mode' }"
                    data-tooltip="Clear"
                    t-on-click.prevent="onClickActionButton"
                >
                    <img src="/web_view_google_map_drawing/static/img/delete.svg" alt="Clear" draggable="false" />
                </button>
                <button
                    id="delete-selected-button"
                    t-att-class="{ 'mode-button': true, 'active': state.activeButton === 'delete-selected-button' }"
                    data-tooltip="Clear last or selected"
                    t-on-click.prevent="onClickActionButton"
                >
                    <img
                        src="/web_view_google_map_drawing/static/img/delete-selected.svg"
                        alt="Delete Selected"
                        draggable="false"
                    />
                </button>
                <button
                    id="undo-button"
                    class="mode-button"
                    data-tooltip="Undo"
                    t-on-click.prevent="onClickActionButton"
                >
                    <img src="/web_view_google_map_drawing/static/img/undo.svg" alt="Undo" draggable="false" />
                </button>
                <button
                    id="redo-button"
                    class="mode-button"
                    data-tooltip="Redo"
                    t-on-click.prevent="onClickActionButton"
                >
                    <img src="/web_view_google_map_drawing/static/img/redo.svg" alt="Redo" draggable="false" />
                </button>
                <button
                    id="simplify-feature-button"
                    class="mode-button"
                    data-tooltip="Simplify Selected Feature"
                    t-on-click.prevent="onClickActionButton"
                    t-att-disabled="!state.selectedFeatureId"
                >
                    <span class="fa fa-compress fa-lg" />
                </button>
                <button
                    id="upload-button"
                    class="mode-button"
                    data-tooltip="Upload GeoJSON"
                    t-on-click.prevent="onClickActionButton"
                >
                    <span class="fa fa-upload fa-lg" />
                </button>
                <button
                    id="download-button"
                    class="mode-button"
                    data-tooltip="Download GeoJSON"
                    t-on-click.prevent="onClickActionButton"
                >
                    <span class="fa fa-download fa-lg" />
                </button>
                <button
                    id="save-button"
                    class="mode-button"
                    data-tooltip="Save Changes (Ctrl+S)"
                    t-on-click.prevent="onClickActionButton"
                >
                    <span class="fa fa-save fa-lg" />
                </button>
            </div>
        </div>
    </t>
</templates>
