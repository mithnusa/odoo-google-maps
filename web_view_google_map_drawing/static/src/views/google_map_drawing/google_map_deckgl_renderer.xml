<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="web_view_google_map_drawing.ShapeInfoWindow">
        <div class="infoWindow">
            <article role="link" class="o_kanban_record d-flex flex-grow-1 flex-md-shrink-1 flex-shrink-0 flex-row border-0">
                <main class="ps-2">
                    <div class="mb-1">
                        <a href="#" role="button" t-att-data-id="recordId" class="text-decoration-none" id="btn-open_form">
                            <h4 t-esc="title"/>
                        </a>
                    </div>
                    <div t-if="subTitle">
                        <t t-esc="subTitle"/>
                    </div>
                </main>
            </article>
        </div>
    </t>
    <t t-name="web_view_google_map_drawing.FeatureProperties">
        <div class="text-800">
            <p class="mb-0 pb-0 fs-4" t-out="title"/>
            <div class="mt-1" t-if="displayNames">
                <ul class="list-unstyled mb-1 pb-1">
                    <t t-foreach="displayNames" t-as="displayName" t-key="displayNameIndex">
                        <li class="font-monospace" style="font-size:11.5px;">
                            <span t-out="displayName.title"/>
                            <span>:</span>
                            <span class="ms-1" t-out="displayName.value"/>
                        </li>
                    </t>
                </ul>
            </div>
            <!-- Show more original properties -->
            <div class="popup-more-properties mt-2" t-if="properties">
                <div class="properties-list" style="max-height: 150px; overflow-y: auto; margin-top: 6px; padding-top: 6px; border-top: 1px solid #ecf0f1;">
                    <t t-foreach="Object.entries(properties)" t-as="entry" t-key="entryIndex">
                        <div class="d-flex justify-content-between mb-1 text-muted" style="font-size: 11px;">
                            <span t-out="entry[0] + ':' "/>
                            <span t-out="entry[1]?.toString()"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
