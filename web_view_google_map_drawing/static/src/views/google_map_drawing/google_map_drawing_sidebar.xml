<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="web_view_google_map_drawing.RecordItem"
        t-inherit="web_view_google_map.RecordItem"
        t-inherit-mode="primary"
    >
        <xpath expr="//i[hasclass('o_marker_icon')]" position="attributes">
            <attribute name="data-icon">circle</attribute>
        </xpath>
        <xpath expr="//button[@data-role='action-show-nearby']" position="replace" />
    </t>
    <t
        t-name="web_view_google_map_drawing.GroupItem"
        t-inherit="web_view_google_map.GroupItem"
        t-inherit-mode="primary"
    >
        <xpath expr="//i[hasclass('o_marker_icon')]" position="attributes">
            <attribute name="data-icon">circle</attribute>
        </xpath>
    </t>
</templates>
