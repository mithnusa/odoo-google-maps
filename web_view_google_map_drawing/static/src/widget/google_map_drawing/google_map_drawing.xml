<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <div t-name="web_view_google_map_drawing.GoogleDrawingField">
        <InMapSearchPlaces googleMap="googleMap"/>
        <div class="o_google_map_renderer">
            <div class="o_google_map_view" id="o_google_map_view" t-ref="map"></div>
            <Geolocate googleMap="googleMap"/>
        </div>
    </div>
    <t t-name="web_view_google_map_drawing.ButtonActionDelete">
        <div style="border: 0.5px solid #cccccc; background-color: white;margin-top: 4.5px;height: 35px;border-radius: 4px;" id="custom-control-drawing-buttons">
            <button class="btn btn-light" id="delete" style="padding: 7px 10px;" type="button" data-toggle="tooltip" data-placement="bottom" title="Delete shape">
                <i class="fa fa-lg fa-trash-o"></i>
            </button>
        </div>
    </t>
</templates>
