<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="partner_autocomplete_with_google_autocomplete.PartnerAutoCompleteCharFieldWithGooglePlaceInitOne" t-inherit="partner_autocomplete.PartnerAutoCompleteCharField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_field_input_buttons')]" position="replace"/>
        <xpath expr="//input" position="after">
            <div class="o_gplace_autocomplete_wrapper" id="o_google_place_autocomplete_wrapper">
                <div class="d-flex align-items-stretch gap-1"/>
            </div>
        </xpath>
    </t>
    <t t-name="partner_autocomplete_with_google_autocomplete.PartnerAutoCompleteCharFieldWithGooglePlaceInitTwo" t-inherit="partner_autocomplete_with_google_autocomplete.PartnerAutoCompleteCharFieldWithGooglePlaceInitOne" t-inherit-mode="primary">
        <xpath expr="//div[@id='o_google_place_autocomplete_wrapper']/div" position="inside">
            <xpath expr="//input" position="move"/>
            <a t-attf-href="#{ '#' + widgetId }"
                class="btn btn-light align-content-center o_gplace_toggle collapsed"
                role="button"
                t-if="!props.readonly"
                data-bs-toggle="collapse"
                t-attf-data-bs-target="#{ '#' + widgetId }"
                data-tooltip="Google Autocomplete"
                title="Google Autocomplete"
                aria-expanded="false"
                t-on-click.prevent="toggleCollapse"
                t-ref="googleAutocompleteToggle"
                t-attf-aria-controls="#{ widgetId }">
                <div class="d-flex gap-1 align-items-center">
                    <i class="fa fa-google"></i>
                    <i class="fa fa-angle-down o_gplace_toggle_icon"></i>
                </div>
            </a>
        </xpath>
        <xpath expr="//div[@id='o_google_place_autocomplete_wrapper']" position="after">
            <div class="collapse" t-attf-id="#{ widgetId }" t-if="!props.readonly">
                <t t-if="state.mappingId">
                    <GooglePlaceAutocompleteElement
                        id="state.mappingId"
                        code="mappingConfig.code"
                        mode="mappingConfig.mode"
                        options="mappingConfig.options"
                        fields="mappingConfig.fields"
                        resModel="props.record.resModel"
                        elementId="widgetId + '_google_places'"
                        callback.bind="saveChanges"
                        isCollapseOpen="state.isCollapseOpen"
                    />
                </t>
                <t t-else="">
                    <div>
                        <p class="small mb-0 text-center">
                            <i class="fa fa-refresh fa-spin fa-fw"></i>
                            <span class="sr-only">Loading...</span>
                        </p>
                    </div>
                </t>
            </div>
        </xpath>
        <xpath expr="//PartnerAutoComplete" position="after">
            <div class="o_gplace_autocomplete_wrapper" id="o_google_place_autocomplete_wrapper_with_partner_autocomplete">
                <div class="d-flex align-items-stretch gap-1"></div>
            </div>
        </xpath>
    </t>
    <t t-name="partner_autocomplete_with_google_autocomplete.PartnerAutoCompleteCharFieldWithGooglePlace" t-inherit="partner_autocomplete_with_google_autocomplete.PartnerAutoCompleteCharFieldWithGooglePlaceInitTwo" t-inherit-mode="primary">
        <xpath expr="//div[@id='o_google_place_autocomplete_wrapper_with_partner_autocomplete']/div" position="inside">
            <xpath expr="//PartnerAutoComplete" position="move"/>
            <a t-attf-href="#{ '#' + widgetId }"
                t-if="!props.readonly"
                class="btn btn-light align-content-center o_gplace_toggle collapsed"
                role="button"
                data-bs-toggle="collapse"
                data-tooltip="Google Autocomplete"
                title="Google Autocomplete"
                aria-expanded="false"
                t-on-click.prevent="toggleCollapse"
                t-ref="googleAutocompleteToggle"
                t-attf-data-bs-target="#{ '#' + widgetId }"
                t-attf-aria-controls="#{ widgetId }">
                <div class="d-flex gap-1 align-items-center">
                    <i class="fa fa-google"></i>
                    <i class="fa fa-angle-down o_gplace_toggle_icon"></i>
                </div>
            </a>
        </xpath>
        <xpath expr="//div[@id='o_google_place_autocomplete_wrapper_with_partner_autocomplete']" position="after">
            <div class="collapse" t-attf-id="#{ widgetId }" t-if="!props.readonly">
                <t t-if="state.mappingId">
                    <GooglePlaceAutocompleteElement
                        id="state.mappingId"
                        code="mappingConfig.code"
                        mode="mappingConfig.mode"
                        options="mappingConfig.options"
                        fields="mappingConfig.fields"
                        resModel="props.record.resModel"
                        elementId="widgetId + '_google_places'"
                        callback.bind="saveChanges"
                        isCollapseOpen="state.isCollapseOpen"
                    />
                </t>
                <t t-elif="state.mappingId == 0">
                    <div class="bg-100 ps-2 pe-2 pb-2 pt-1 mt-1 rounded-2 shadow-sm">
                        <p class="small mb-0 text-center">
                            <i class="fa fa-refresh fa-spin fa-fw"></i>
                            <span class="sr-only">Loading...</span>
                        </p>
                    </div>
                </t>
            </div>
        </xpath>
    </t>
</templates>