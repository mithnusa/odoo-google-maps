<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_crm_lead_form_inherit_google_places_autocomplete" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.google.places.autocomplete</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lead_partner']/field[@name='partner_name']" position="attributes">
                <attribute name="widget">gplace_autocomplete_el</attribute>
                <attribute name="options">{'mapping_mode': 'places'}</attribute>
            </xpath>
            <xpath expr="//group[@name='lead_partner']//field[@name='street']" position="attributes">
                <attribute name="widget">gplace_autocomplete_el</attribute>
                <attribute name="options">{'mapping_mode': 'address'}</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']//field[@name='partner_name']" position="attributes">
                <attribute name="widget">gplace_autocomplete_el</attribute>
                <attribute name="options">{'mapping_mode': 'places'}</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']//field[@name='street']" position="attributes">
                <attribute name="widget">gplace_autocomplete_el</attribute>
                <attribute name="options">{'mapping_mode': 'address'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
