<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.base_google_map</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="500"/>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='integration']" position="after">
                    <block name="base_google_map" title="Google Maps">
                        <setting id="google_maps_view_api_key">
                            <div>
                                API Key: <field name="google_maps_view_api_key" string="API Key"/>
                            </div>
                            <div class="content-group">
                                <div class="mt16 text-muted">
                                    <div>Google API Key and Map Localization</div>
                                    <div>Visit this page <a href="https://developers.google.com/maps/documentation/javascript/localization" target="_blank">page</a> about Localizing the Map</div>
                                </div>
                            </div>
                        </setting>
                        <setting id="google_maps_libraries">
                            <field name="google_maps_libraries" string="Libraries"/>
                        </setting>
                        <setting id="google_maps_lang_localization" >
                            <field name="google_maps_lang_localization" string="Language"/>
                        </setting>
                        <setting id="google_maps_region_localization" help="If you set the language of the map, it's important to consider setting the region too. This helps ensure that your application complies with local laws.">
                            <field name="google_maps_region_localization" string="Region"/>
                        </setting>
                        <setting id="google_maps_theme">
                            <field name="google_maps_theme" string="Theme" widget="radio"/>
                        </setting>
                        <setting id="google_autocomplete_lang_restrict" help="The language code, indicating in which language the results should be returned, if possible. Searches are also biased to the selected language; results in the selected language may be given a higher ranking.">
                            <field name="google_autocomplete_lang_restrict"/>
                        </setting>
                        <setting id="google_enable_map_place_search">
                            <field name="google_enable_map_place_search"/>
                            <div class="content-group">
                                <div class="mt16 text-muted">Enable Google Places Search Autocomplete in Google map. This feature required the &#8220;Places API&#8221; to be enabled in your Google API key.</div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
