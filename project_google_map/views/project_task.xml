<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_project_task_google_map" model="ir.ui.view">
        <field name="name">project.task.google.map</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <google_map
                js_class="google_map_drawing_project_task"
                string="Task Sites"
                geojson="geojson"
                color="geojson_color"
                sidebar_title="name"
                sidebar_subtitle="project_id"
            >
                <field name="name" />
                <field name="geojson_color" />
                <field name="project_id" />
                <field name="geojson" />
                <field name="geojson_area" />
                <field name="project_geojson" />
            </google_map>
        </field>
    </record>
    <record id="view_project_task_form2_inherit_google_map" model="ir.ui.view">
        <field name="name">view.project.task.form2.inherit.google_map</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page string="Site">
                    <field name="project_geojson" invisible="1" />
                    <field
                        name="geojson"
                        widget="google_map_terra_draw_project_task"
                        options="{'field_area': 'geojson_area'}"
                    />
                    <group>
                        <group>
                            <label for="project_geojson_area" />
                            <div>
                                <field name="project_geojson_area" class="oe_inline" nolabel="1" />
                                <span class="ms-1">m</span>
                                <sup>2</sup>
                            </div>
                            <label for="geojson_area" />
                            <div>
                                <field name="geojson_area" class="oe_inline" nolabel="1" />
                                <span class="ms-1">m</span>
                                <sup>2</sup>
                            </div>
                        </group>
                        <group>
                            <field name="geojson_color" widget="color_picker" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
