<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_project_project_google_map" model="ir.ui.view">
        <field name="name">project.project.google.map</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <google_map
                js_class="google_map_drawing_project"
                string="Project Sites"
                geojson="geojson"
                color="geojson_color"
                sidebar_title="name"
                sidebar_subtitle="partner_id"
            >
                <field name="name" />
                <field name="partner_id" />
                <field name="geojson" />
                <field name="geojson_color" />
            </google_map>
        </field>
    </record>
    <record id="view_project_project_google_map_form" model="ir.ui.view">
        <field name="name">project.project.google.map.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//page[1]" position="after">
                <page string="Site">
                    <field name="geojson" widget="google_map_terra_draw" options="{'field_area': 'geojson_area'}" />
                    <group>
                        <group>
                            <label for="geojson_area" />
                            <div>
                                <field name="geojson_area" class="oe_inline" nolabel="1" />
                                <span class="ms-1">m</span>
                                <sup>2</sup>
                            </div>
                        </group>
                        <group>
                            <field name="geojson_color" widget="color" readonly="1" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
