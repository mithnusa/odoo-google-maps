<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_widget_google_map.GooglePlacesMappingTestField">
        <div class="mb-2">
            <p class="small mb-1 text-muted">Google Places Autocomplete</p>
            <div t-ref="divInput" t-attf-id="#{ props.id + '_google_places' }" class="o_google_places_element"></div>
        </div>
    </t>
    <t t-name="web_widget_google_map.ViewMappingResult">
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                <p class="fs-4 mb-1">Address</p>
                <pre><t t-out="addressMappingResult"/></pre>
            </li>
            <li class="list-group-item" t-if="mode == 'places'">
                <p class="fs-4 mb-1">Other</p>
                <pre><t t-out="otherMappingResult"/></pre>
            </li>
            <li class="list-group-item">
                <p class="fs-4 mb-1">Geolocation</p>
                <pre><t t-out="geoLocationResult"/></pre>
            </li>
            <li class="list-group-item">
                <p class="fs-4 mb-1">Google Place Raw</p>
                <pre><t t-out="placeDetailsResult"/></pre>
            </li>
        </ul>
    </t>
</templates>
