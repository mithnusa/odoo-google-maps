<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_places_mapping_form" model="ir.ui.view">
        <field name="name">view.google.places.mapping.form</field>
        <field name="model">google.places.mapping</field>
        <field name="arch" type="xml">
            <form string="Google Places Mapping">
                <sheet>
                    <field name="id" invisible="1"/>
                    <field name="is_address_component_missing" invisible="1"/>
                    <field name="is_location_field_missing" invisible="1"/>
                    <div class="alert alert-warning text-center" role="alert" invisible="not is_address_component_missing">
                        <span>"addressComponents" is not configured in "Google Places Fetch Fields". This value is required for address mapping</span>
                    </div>
                    <div class="alert alert-warning text-center" role="alert" invisible="not is_location_field_missing">
                        <span>"location" is not configured in "Google Places Fetch Fields". This value is required for latitude and longitude mapping</span>
                    </div>
                    <div class="alert alert-info text-center" role="alert" invisible="not id or not code">
                        <p class="mb-0 fw-light fs-2">Please make sure to test before using the mapping</p>
                        <field name="place_id_test" widget="GoogleMappingTest"/>
                        <p class="mb-0">
                            <small class="fst-italic" style="font-size:12px;">* When testing the mapping, please reload the page whenever a value is changed.</small>
                        </p>
                    </div>
                    <div class="oe_title">
                        <label for="code" class="oe_edit_only"/>
                        <h1>
                            <field name="code" class="oe_inline" widget="CopyClipboardChar"/>
                        </h1>
                        <field name="mode" widget="radio" options="{'horizontal': true}" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="latitude" options="{'no_create': True}"/>
                            <field name="longitude" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Google Places Options">
                            <label for="gplace_options" string="Options"/>
                            <div>
                                <field name="gplace_options" widget="code" options="{'mode': 'python'}"/>
                                <small class="text-muted">
                                    <span>Before configure the value please check this document first </span>
                                    <a class="text-decoration-underline" href="https://developers.google.com/maps/documentation/javascript/reference/places-widget#PlaceAutocompleteElementOptions" target="_blank">PlaceAutocompleteElementOptions interface</a>
                                </small>
                            </div>
                        </group>
                        <group string="Google Places Property Fields">
                            <label for="gplace_place_fetch_fields" string="Fields" invisible="mode == 'address'"/>
                            <div invisible="mode == 'address'">
                                <field name="gplace_place_fetch_fields" widget="code" options="{'mode': 'python'}" required="1" invisible="mode == 'address'"/>
                                <small class="text-muted">
                                    <span>Before configure the value please check this document first </span>
                                    <a class="text-decoration-underline" href="https://developers.google.com/maps/documentation/javascript/place-class-data-fields" target="_blank">Place Class Data Fields</a>
                                </small>
                            </div>
                            <label for="gplace_address_fetch_fields" string="Fields" invisible="mode == 'places'"/>
                            <div invisible="mode == 'places'">
                                <field name="gplace_address_fetch_fields" widget="code" options="{'mode': 'python'}" readonly="1" invisible="mode == 'places'"/>
                                <small class="text-muted">
                                    <span>Before configure the value please check this document first </span>
                                    <a class="text-decoration-underline" href="https://developers.google.com/maps/documentation/javascript/place-class-data-fields" target="_blank">Place Class Data Fields</a>
                                </small>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mappings">
                            <div class="row">
                                <div class="col-6">
                                    <p class="fw-bolder">Address Mapping</p>
                                    <field name="mapping_address_ids" nolabel="1">
                                        <list editable="top">
                                            <field name="model_id" column_invisible="1"/>
                                            <field name="field_id" options="{'no_create': True}"/>
                                            <field name="gplace_component" widget="code" options="{'mode': 'python'}"/>
                                            <field name="text_option"/>
                                        </list>
                                    </field>
                                    <p>
                                        <small class="text-muted">
                                            <span>The format of "route" and "street_number" will be configured dynamically based on the address's country. Check the <a class="text-decoration-underline" href="/web#action=base.action_country&amp;model=res.country&amp;view_type=list">Country</a> setting if you want to change the order.</span>
                                        </small>
                                    </p>
                                </div>
                                <div class="col-6" invisible="mode != 'places'">
                                    <p class="fw-bolder">Other Mapping</p>
                                    <field name="mapping_other_ids" nolabel="1">
                                        <list editable="top">
                                            <field name="model_id" column_invisible="1"/>
                                            <field name="field_id" options="{'no_create': True}"/>
                                            <field name="gplace_component" widget="code" options="{'mode': 'python'}"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </page>
                    </notebook>
                    <div class="row mt-2">
                        <div class="col">
                            <h2>References:</h2>
                            <ul>
                                <li>
                                    <a class="text-decoration-underline" href="https://developers.google.com/maps/documentation/places/web-service/place-autocomplete" target="_blank">Places Autocomplete</a>
                                </li>
                                <li>
                                    <a class="text-decoration-underline" href="https://developers.google.com/maps/documentation/javascript/place-class-data-fields" target="_blank">Place Class Data Fields</a>
                                </li>
                                <li>
                                    <a class="text-decoration-underline" href="https://developers.google.com/maps/documentation/javascript/place-types" target="_blank">Place Types</a>
                                </li>
                                <li>
                                    <a class="text-decoration-underline" href="https://developers.google.com/maps/documentation/javascript/place-types#address-types" target="_blank">Address types and address component types</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_google_places_mapping_tree" model="ir.ui.view">
        <field name="name">view.google.places.mapping.tree</field>
        <field name="model">google.places.mapping</field>
        <field name="arch" type="xml">
            <list string="Google Places Mappings">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="model_id"/>
                <field name="mode"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_google_places_mapping" model="ir.actions.act_window">
        <field name="name">Google Places Mappings</field>
        <field name="res_model">google.places.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define Google Places Mappings here.
            </p>
        </field>
    </record>
    <menuitem
        id="menu_google_places_mapping"
        name="Google Places Mapping"
        parent="base.menu_custom"
        sequence="90"
        action="action_google_places_mapping"
        groups="base.group_no_one"/>
</odoo>