<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_widget_google_place_autocomplete.GooglePlacesMappingTestField">
        <div class="mb-2">
            <GooglePlaceAutocompleteElement
                isTest="true"
                id="config.id"
                code="config.code"
                mode="config.mode"
                options="config.options"
                fields="config.fields"
                resModel="props.record.resModel"
                elementId="widgetId + '_google_places'"
                callback.bind="showValues"
            />
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-secondary w-50" t-on-click="reloadTestPlaceAutocomplete">
                    Reload
                </button>
            </div>
        </div>
    </t>
    <t t-name="web_widget_google_place_autocomplete.ViewMappingResult">
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                <p class="fs-4 mb-1">
                    <i class="fa fa-angle-right me-1"></i>
                    <span>Address</span>
                </p>
                <pre><t t-out="addressMappingResult"/></pre>
            </li>
            <li class="list-group-item" t-if="mode == 'places'">
                <p class="fs-4 mb-1">
                    <i class="fa fa-angle-right me-1"></i>
                    <span>Other</span>
                </p>
                <pre><t t-out="otherMappingResult"/></pre>
            </li>
            <li class="list-group-item">
                <p class="fs-4 mb-1">
                    <i class="fa fa-angle-right me-1"></i>
                    <span>Geolocation</span>
                </p>
                <pre><t t-out="geoLocationResult"/></pre>
            </li>
            <li class="list-group-item">
                <p class="fs-4 mb-1">
                    <i class="fa fa-angle-right me-1"></i>
                    <span>Google Place JSON</span>
                </p>
                <pre><t t-out="placeDetailsResult"/></pre>
            </li>
        </ul>
    </t>
</templates>
