<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_widget_google_place_autocomplete.GooglePlacesMappingTestField">
        <div class="mb-2">
            <GooglePlaceAutocompleteElement
                isTest="true"
                id="this.config.id"
                code="this.config.code"
                mode="this.config.mode"
                options="this.config.options"
                fields="this.config.fields"
                resModel="this.props.record.resModel"
                elementId="this.widgetId + '_google_places'"
                callback.bind="this.showValues"
            />
            <div class="mt-2">
                <button type="button" class="btn btn-sm btn-secondary w-50" t-on-click="this.reloadTestPlaceAutocomplete">
                    Reload
                </button>
            </div>
        </div>
    </t>
    <t t-name="web_widget_google_place_autocomplete.ViewMappingResult">
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                <p class="fs-4 mb-1">
                    <i class="fa fa-angle-right me-1" />
                    <span>Address</span>
                </p>
                <pre t-out="this.addressMappingResult" />
            </li>
            <li t-if="this.mode == 'places'" class="list-group-item">
                <p class="fs-4 mb-1">
                    <i class="fa fa-angle-right me-1" />
                    <span>Other</span>
                </p>
                <pre t-out="this.otherMappingResult" />
            </li>
            <li class="list-group-item">
                <p class="fs-4 mb-1">
                    <i class="fa fa-angle-right me-1" />
                    <span>Geolocation</span>
                </p>
                <pre t-out="this.geoLocationResult" />
            </li>
            <li class="list-group-item">
                <p class="fs-4 mb-1">
                    <i class="fa fa-angle-right me-1" />
                    <span>Google Place JSON</span>
                </p>
                <pre t-out="this.placeDetailsResult" />
            </li>
        </ul>
    </t>
</templates>
