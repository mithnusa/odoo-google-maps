<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_widget_google_place_autocomplete.GooglePlaceAutocomplete">
        <div class=" bg-100 ps-2 pe-2 pb-2 pt-1 mt-1 rounded-2 shadow-sm">
            <p class="smaller mb-1 fw-lighter font-sans-serif d-flex justify-content-between align-items-center" t-if="props.id">
                <span>Search Google <t t-if="props.mode === 'places'">Place</t><t t-elif="props.mode === 'address'">Address</t></span>
                <span class="ps-1 float-end cursor-pointer" style="font-size: 10px;" data-tooltip="Open Mapping Configuration" t-on-click.prevent="openMappingConfig" t-if="!props.isTest">
                    <i class="fa fa-cog text-600"/>
                </span>
            </p>
            <p class="smaller mb-0 text-warning text-center" t-else="">
                <i class="fa fa-exclamation-triangle"/>
                <span class="ps-1">Missing mapping code or mapping mode</span>
            </p>
            <div t-ref="gAutocomplete" class="o_google_places_element"></div>
        </div>
    </t>
</templates>