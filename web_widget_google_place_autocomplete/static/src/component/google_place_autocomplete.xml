<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_widget_google_place_autocomplete.GooglePlaceAutocomplete">
        <div class="bg-100 ps-2 pe-2 pb-2 pt-1 mt-1 rounded-2 border">
            <p t-if="this.props.id" class="mb-1 d-flex justify-content-between align-items-center fw-normal">
                <small class="text-500">
                    Search Google
                    <t t-if="this.props.mode === 'places'">Place</t>
                    <t t-elif="this.props.mode === 'address'">Address</t>
                </small>
                <span
                    t-if="!this.props.isTest"
                    class="ps-1 float-end cursor-pointer"
                    style="font-size: 10px;"
                    data-tooltip="Open Mapping Configuration"
                    t-on-click.prevent="this.openMappingConfig"
                >
                    <i class="fa fa-cog text-600" />
                </span>
            </p>
            <p t-else="" class="smaller mb-0 text-warning text-center">
                <i class="fa fa-exclamation-triangle" />
                <span class="ps-1">Missing mapping code or mapping mode</span>
            </p>
            <div t-custom-ref="gAutocomplete" class="o_google_places_element" />
        </div>
    </t>
</templates>
