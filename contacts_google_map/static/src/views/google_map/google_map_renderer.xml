<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="contacts_google_map.MarkerInfoWindow" t-inherit="web_view_google_map.MarkerInfoWindow" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('oe_kanban_card')]" position="before">
            <div class="w-50 o_kanban_image_fill_left o_kanban_image_full" role="img" t-attf-style="background-image:url('{{avatarUrl}}')"/>
        </xpath>
        <xpath expr="//div[hasclass('o_kanban_record')]" position="attributes">
            <attribute name="class" add="o_kanban_record_has_image_fill w-100" separator=" "/>
        </xpath>
    </t>
</templates>
