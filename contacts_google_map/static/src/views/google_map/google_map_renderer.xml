<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="contacts_google_map.MarkerInfoWindow"
        t-inherit="web_view_google_map.MarkerInfoWindow"
        t-inherit-mode="primary"
    >
        <xpath expr="//main" position="before">
            <aside t-if="avatarUrl" class="o_kanban_record_image me-2 flex-shrink-0">
                <div class="position-relative w-100 h-auto m-0">
                    <div name="avatar_128" class="o_field_widget o_readonly_modifier o_field_image h-100">
                        <div class="d-inline-block position-relative opacity-trigger-hover">
                            <img
                                loading="lazy"
                                class="img img-fluid object-fit-contain"
                                alt="Contact image"
                                t-attf-src="{{ avatarUrl }}"
                                name="avatar_128"
                                style=""
                            />
                        </div>
                    </div>
                </div>
            </aside>
        </xpath>
    </t>
</templates>
